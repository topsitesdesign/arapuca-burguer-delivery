# Variáveis da versão Vercel + Supabase (cadastre em Vercel › Project › Settings › Environment Variables).
# Os valores de verdade NUNCA vão para o Git. Os dois segredos gerados para esta loja estão no COMO-PUBLICAR-VERCEL.txt (fora do Git).

# Supabase › Connect › Session pooler (porta 5432). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=
# 32 bytes aleatórios em base64 (protege a verificação em duas etapas e as assinaturas)
CHAVE_SISTEMA=
# Código pedido na tela /instalar (só serve até a instalação terminar)
CODIGO_INSTALACAO=
AMBIENTE=producao

# Supabase › Project Settings › API: URL do projeto e a chave service_role (fotos enviadas pelo painel, bucket "uploads")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contato mostrado se o banco cair (a página de "fora do ar" oferece o WhatsApp da loja)
CONTATO_NOME=Arapuca Burguer
CONTATO_WHATSAPP=(81) 98863-6739

# Opcional: conexões com o banco por instância da função (padrão 2)
# DB_CONEXOES=2
